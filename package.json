{
  "name": "arv-seller",
  "version": "1.0.0",
  "description": "Production-grade ArvanCloud Reseller WordPress Plugin with Virtual Canvas, Atomic Wallet, and Sorkhab UI.",
  "type": "module",
  "main": "arv-seller.php",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "watch": "node scripts/dev-server.js",
    "build:frontend": "vite build",
    "watch:frontend": "vite build --watch",
    "test": "node scripts/run-tests.js",
    "lint": "node scripts/lint-php.js",
    "i18n": "node scripts/i18n-tools.js",
    "i18n:php": "php scripts/generate-i18n.php",
    "fonts:download": "node scripts/download-fonts.js",
    "package": "node scripts/package-plugin.js",
    "build": "pnpm run build:frontend && pnpm run lint && pnpm run i18n && pnpm run test && pnpm run package"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "arvancloud",
    "reseller",
    "iaas",
    "cdn",
    "s3",
    "sorkhab"
  ],
  "author": "ArvanCloud Reseller Team",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "chokidar": "^4.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
